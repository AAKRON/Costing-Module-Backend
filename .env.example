# ============================================================
# RAILWAY DEPLOYMENT - Required Environment Variables
# Set these in the Railway dashboard under your service > Variables
# ============================================================

# --- Rails security (REQUIRED) ---
# Generate with: rails secret  (run locally or in Railway shell)
SECRET_KEY_BASE=

# --- Database (REQUIRED) ---
# Add the Railway Postgres addon; Railway auto-sets DATABASE_URL.
# If it sets POSTGRES_URL instead, add this manually:
DATABASE_URL=
# Legacy PG_ vars (used in development/database.yml dev section only)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PG_DB_DEV=
PG_DB_TEST=
PG_DB_PROD=

# --- Redis (REQUIRED) ---
# Add the Railway Redis addon; Railway auto-sets REDIS_URL.
REDIS_URL=

# --- App URLs (REQUIRED for CORS) ---
# Set to the Railway URL of the frontend service (copy from Railway dashboard)
FRONTEND_URL=https://your-frontend-service.up.railway.app
# Public URL of this backend service (used by some mailers/helpers)
BACKEND_HOST=https://your-backend-service.up.railway.app

# --- App API keys (REQUIRED) ---
# Internal API key for item type update webhooks
ITEM_TYPE_UPDATE_APIKEY=

# --- Rails environment (set automatically by Dockerfile, but can override) ---
RAILS_ENV=production
RACK_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true

# --- Monitoring (OPTIONAL) ---
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# ============================================================
# POST-DEPLOY STEPS (one-time, after first successful deploy)
# ============================================================
# 1. Load the database schema (runs db:schema:load):
#    GET https://your-backend.up.railway.app/setup/schema_load
#
# 2. (Optional) Seed initial data:
#    GET https://your-backend.up.railway.app/setup/seed
#
# 3. (Optional) Copy data from production DB:
#    POST https://your-backend.up.railway.app/data_migration/copy_from_production
#
# 4. Verify health check passes:
#    GET https://your-backend.up.railway.app/health
# ============================================================
