#!/bin/bash
set -e

echo "🚀 Starting Costing Module Backend..."

# Set bundler to use production configuration
export BUNDLE_WITHOUT="development:test"

# Skip automatic migrations to avoid bundler issues
echo "⚡ Skipping migrations - use /setup/schema_load endpoint instead"

# Start the application
echo "🌐 Starting Puma server..."
exec bundle exec puma -C config/puma.rb