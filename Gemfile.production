source 'https://rubygems.org'
ruby '3.3.8'

# Core Rails stack
gem 'rails', '~> 7.2.0'
gem 'pg'
gem 'puma', '~> 6.4'
gem 'bcrypt'

# Ruby stdlib gems extracted in Ruby 3.1+
gem 'matrix'
gem 'mutex_m'

# Security & Authentication
gem 'jwt'
gem 'rack-attack'
gem 'secure_headers'
gem 'rack-cors', require: 'rack/cors'

# Core functionality
gem 'jbuilder'
gem 'kaminari'
gem 'redis'
gem 'connection_pool', '~> 2.4'
gem 'sidekiq'

# Error monitoring
gem 'sentry-ruby'
gem 'sentry-rails'

# File processing
gem 'rubyXL'
gem 'smarter_csv'
gem 'caxlsx'
gem 'caxlsx_rails'
gem 'roo'
gem 'prawn'
gem 'prawn-table'

# Database & utilities
gem 'scenic'
gem 'upsert'

# Monitoring
gem 'newrelic_rpm'

gem 'bootsnap', require: false
gem 'tzinfo-data', platforms: %i[mingw mswin x64_mingw jruby]
